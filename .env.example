# --- Required ---
SUPABASE_URL=https://opcdbpbnhabdcqkfrjrt.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# --- AI: Groq does the thinking (captions, checks, chat); Gemini free text is the fallback ---
AI_PRIMARY=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Only works on a billed Gemini project (the free tier has no image models)
GEMINI_IMAGE_MODEL=

# --- Agnes AI: product image → ad image → 9:16 video (free models) ---
AGNES_API_KEY=
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
VIDEO_SECONDS=8

# --- Background (Render) ---
# Posting times use this zone
TZ=Africa/Lagos
# Render sets RENDER_EXTERNAL_URL itself; the server pings its own /health
# every KEEPALIVE_MINUTES while autopilot is on, so the free tier doesn't sleep.
KEEPALIVE_MINUTES=12

# --- App ---
APP_URL=http://localhost:3000
CRON_SECRET=
LOG_LEVEL=warn

# --- AliExpress affiliate (optional) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# --- Social OAuth (optional until you connect accounts) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Split mode (frontend on Vercel → backend on Render) ────────────────
# Set this on VERCEL only (not on Render): when present, /api/* and /c/:code
# are proxied to the external Fastify backend and it never runs in-process.
API_ORIGIN=https://baymax-shoppey-api.onrender.com
